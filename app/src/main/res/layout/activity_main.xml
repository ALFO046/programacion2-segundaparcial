<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#F5F5F5"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sistema de Gestión de Clientes"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#2196F3"
        android:layout_marginBottom="40dp"
        android:textAlignment="center"/>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardElevation="4dp"
        app:cardCornerRadius="12dp">

        <Button
            android:id="@+id/btnFormularioCliente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📋 Registrar Cliente"
            android:textSize="16sp"
            android:padding="16dp"
            android:background="?attr/selectableItemBackground"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardElevation="4dp"
        app:cardCornerRadius="12dp">

        <Button
            android:id="@+id/btnCargaArchivos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📁 Cargar Archivos"
            android:textSize="16sp"
            android:padding="16dp"
            android:background="?attr/selectableItemBackground"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="4dp"
        app:cardCornerRadius="12dp">

        <Button
            android:id="@+id/btnVerLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 Ver Logs"
            android:textSize="16sp"
            android:padding="16dp"
            android:background="?attr/selectableItemBackground"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WorkManager sincroniza logs cada 5 minutos (mínimo permitido)"
        android:textSize="12sp"
        android:textColor="#757575"
        android:layout_marginTop="40dp"
        android:textAlignment="center"/>

</LinearLayout>
