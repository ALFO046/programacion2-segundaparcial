<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".CargaArchivosActivity">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_ci_carga"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="CI del Cliente" />
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/btn_seleccionar_archivos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Seleccionar Archivos" />

    <TextView
        android:id="@+id/tv_contador_archivos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Archivos seleccionados: 0"
        android:textAlignment="center"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        android:textSize="16sp"/>

    <Button
        android:id="@+id/btn_enviar_zip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Comprimir y Enviar Archivos" />

</LinearLayout>
